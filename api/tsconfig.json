{
  // Vercel compiles these serverless functions with the nearest tsconfig.
  // The root config uses "module": "preserve" for Angular, which leaves ESM
  // import syntax in the emitted .js and crashes Node ("Cannot use import
  // statement outside a module"). Functions must compile to CommonJS.
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
